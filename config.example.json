  "image_settle_enabled": false,
  "image_check_before_hit_enabled": false,
  "image_settle_secs": 2,
  "auto_relogin_after_refresh": false,
  "image_timeout_retry_secs": 30,
  "image_remove_conversation_after_result": true,
